{
    "name": "adman9000/laravel-binance",
    "description": "Laravel implementation of the Binance crypto exchange trading API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Adam Harding",
            "email": "myaddressistaken@googlemail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "adman9000\\binance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "adman9000\\binance\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "adman9000\\binance\\BinanceServiceProvider"
            ],
            "aliases": {
                "Binance": "adman9000\\binance\\BinanceAPIFacade"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
